# Engine selectors — the library has no default provider; the app's menus
# fill these in for you (Providers & models menu). Completions default to
# Anthropic Claude with Gemini as the fallback. Anthropic has no embeddings,
# image, video, or voice API, so those default to Google.
COMPLETIONS_ENGINE=claude
EMBEDDING_ENGINE=google-gemini
IMAGE_ENGINE=google-gemini
VIDEO_ENGINE=google-gemini
AI_VOICE_ENGINE=google

# Model overrides (optional — providers have sensible defaults)
COMPLETIONS_MODEL_NAME=claude-opus-5
EMBEDDING_MODEL_NAME=gemini-embedding-001
IMAGE_MODEL_NAME=gemini-3.1-flash-image
VIDEO_MODEL_NAME=veo-3.1-lite-generate-preview
DEFAULT_GEMINI_TTS_MODEL=gemini-2.5-pro-tts

# Model fallback (library 2.32) — change or turn off from the Providers screen
# ("Fallback chain…"). Ordered engine:model pairs tried after the primary
# fails; blank means no chain. Each fallback engine needs its own credentials.
COMPLETIONS_FALLBACKS=google-gemini:gemini-3.7-flash
# Failures that move a request to the next model. Leave unset to use the
# library default (shown below), which can grow in new releases. Set it only to
# change the list, e.g. add model_unavailable or timeout.
# COMPLETIONS_FALLBACK_ON=unavailable,rate_limited,quota_exhausted,auth_rejected

# Provider credentials — leave blank; the app walks you through getting and
# saving each key the first time you use a provider.
GOOGLE_GEMINI_API_KEY=
GOOGLE_AUTH_METHOD=api_key
# With GOOGLE_AUTH_METHOD=service_account (Vertex AI), Gemini 3.x models such as
# the gemini-3.7-flash fallback are served only from the global location.
# GOOGLE_LOCATION=global
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MICROSOFT_COGNITIVE_SERVICES_API_KEY=
MICROSOFT_COGNITIVE_SERVICES_REGION=
ELEVEN_LABS_API_KEY=

# Middleware — managed by the app's middleware profile editor.
# AI_MIDDLEWARE_CONFIG_PATH=config/middleware.yaml
